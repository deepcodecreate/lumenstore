<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:minHeight="62dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="20dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_bottom_nav_capsule"
    android:clipToOutline="true"
    android:elevation="0dp"
    android:outlineProvider="background"
    android:transitionName="bottomNav"
    app:elevation="0dp"
    app:itemRippleColor="@android:color/transparent"
    app:paddingBottomSystemWindowInsets="false"
    app:itemActiveIndicatorStyle="@style/Widget.App.BottomNav.ActiveIndicator"
    app:itemIconSize="20dp"
    app:itemIconTint="@color/bottom_nav_tint"
    app:activeIndicatorLabelPadding="3dp"
    app:itemPaddingTop="10dp"
    app:itemPaddingBottom="8dp"
    app:itemTextAppearanceActive="@style/TextAppearance.App.NavLabel"
    app:itemTextAppearanceInactive="@style/TextAppearance.App.NavLabel"
    app:itemTextColor="@color/bottom_nav_tint"
    app:labelVisibilityMode="labeled"
    app:menu="@menu/menu_bottom_nav" />
