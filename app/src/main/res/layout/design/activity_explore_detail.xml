<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/colorSurface"
		app:elevation="0dp"
		app:liftOnScroll="false">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.MaterialToolbarDesign
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:navigationIcon="@drawable/ic_arrow_back"
			app:navigationIconTint="?attr/colorOnSurface" />
	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign>
	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.NestedScrollViewDesign
		android:id="@+id/detailScroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		app:layout_behavior="@string/appbar_scrolling_view_behavior"
		android:padding="4dp">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="4dp">
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="20dp"
				android:layout_marginEnd="20dp"
				android:layout_marginTop="4dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
				app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:gravity="center_horizontal"
					android:padding="8dp">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign
						android:layout_width="96dp"
						android:layout_height="96dp"
						android:background="@drawable/icon_container_bg">
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/exploreDetailIcon"
							android:layout_width="60dp"
							android:layout_height="60dp"
							android:layout_gravity="center"
							app:shapeAppearanceOverlay="@style/ShapeAppearance.App.IconRounded" />
					</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign>
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/exploreDetailName"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:gravity="center"
						android:textAlignment="center"
						android:textAppearance="?attr/textAppearanceHeadlineSmall"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/exploreDetailMeta"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:gravity="center"
						android:textAlignment="center"
						android:visibility="gone"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:textColor="?attr/colorOnSurfaceVariant" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:orientation="horizontal">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/exploreDetailUpdatedBox"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
							app:shapeAppearance="?attr/shapeAppearanceCornerSmall"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
								android:id="@+id/exploreDetailUpdated"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="4dp"
								android:gravity="center"
								android:textAlignment="center"
								android:textAppearance="?attr/textAppearanceTitleSmall"
								android:textColor="?attr/colorOnSurface" />
						</com.google.android.material.card.MaterialCardView>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/exploreDetailSizeBox"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:layout_marginStart="10dp"
							app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
							app:shapeAppearance="?attr/shapeAppearanceCornerSmall"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
								android:id="@+id/exploreDetailSize"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="4dp"
								android:gravity="center"
								android:textAlignment="center"
								android:textAppearance="?attr/textAppearanceTitleSmall"
								android:textColor="?attr/colorOnSurface" />
						</com.google.android.material.card.MaterialCardView>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/exploreDetailRepoBox"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:layout_marginStart="10dp"
							app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
							app:shapeAppearance="?attr/shapeAppearanceCornerSmall"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
								android:id="@+id/exploreDetailRepo"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="4dp"
								android:gravity="center"
								android:textAlignment="center"
								android:textAppearance="?attr/textAppearanceTitleSmall"
								android:textColor="?attr/colorOnSurface" />
						</com.google.android.material.card.MaterialCardView>
					</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
					<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ViewDesign
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="18dp"
						android:background="?attr/colorOutlineVariant" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
						android:id="@+id/exploreDetailActions"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						android:orientation="horizontal">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/exploreDetailInstall"
							style="@style/Widget.Material3.Button"
							android:layout_width="0dp"
							android:layout_height="wrap_content" android:minHeight="52dp"
							android:layout_weight="1"
							android:text="@string/download_and_install"
							android:textAllCaps="false"
							app:cornerRadius="26dp" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/exploreDetailCancel"
style="@style/Widget.App.Button.TonalButton"
							android:layout_width="0dp"
							android:layout_height="wrap_content" android:minHeight="52dp"
							android:layout_weight="1"
							android:layout_marginStart="8dp"
							android:text="@string/cancel"
							android:textAllCaps="false"
							android:visibility="gone"
							app:cornerRadius="26dp" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/exploreDetailOpen"
style="@style/Widget.App.Button.TonalButton"
							android:layout_width="0dp"
							android:layout_height="wrap_content" android:minHeight="52dp"
							android:layout_weight="1"
							android:layout_marginStart="8dp"
							android:text="@string/action_run"
							android:textAllCaps="false"
							android:visibility="gone"
							app:cornerRadius="26dp" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/exploreDetailUninstall"
style="@style/Widget.App.Button.TonalButton"
							android:layout_width="0dp"
							android:layout_height="wrap_content" android:minHeight="52dp"
							android:layout_weight="1"
							android:layout_marginStart="8dp"
							android:text="@string/uninstall"
							android:textAllCaps="false"
							android:visibility="gone"
							app:cornerRadius="26dp" />
					</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
					<com.google.android.material.progressindicator.LinearProgressIndicator
						android:id="@+id/exploreDetailProgress"
						style="@style/Widget.App.LinearProgress"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:visibility="gone" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			</com.google.android.material.card.MaterialCardView>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign
				android:id="@+id/exploreDetailScreenshotsScroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:paddingStart="4dp"
				android:paddingEnd="4dp"
				android:scrollbars="none"
				android:visibility="gone">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailScreenshots"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal" />
			</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="4dp"
				android:paddingEnd="4dp">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/exploreDetailAntiFeaturesCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					app:shapeAppearance="?attr/shapeAppearanceCornerMedium"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					android:visibility="gone">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="4dp">
						<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="@string/anti_features_warning"
							android:textAppearance="?attr/textAppearanceTitleSmall"
							android:textColor="?attr/colorOnSurface" />
						<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
							android:id="@+id/exploreDetailAntiFeaturesText"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:textColor="?attr/colorOnSurfaceVariant" />
					</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
				</com.google.android.material.card.MaterialCardView>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailDescriptionSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:orientation="vertical">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Description"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:textColor="?attr/colorOnSurface" />
					<com.google.android.material.card.MaterialCardView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
						app:shapeAppearance="?attr/shapeAppearanceCornerMedium"
						app:cardElevation="0dp"
						app:strokeWidth="0dp">
						<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:padding="4dp">
							<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign
								android:id="@+id/exploreDetailCategoriesScroll"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="12dp"
								android:scrollbars="none"
								android:fillViewport="false">
								<org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.ChipGroupDesign
									android:id="@+id/exploreDetailCategories"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									app:singleLine="true"
									app:chipSpacingHorizontal="8dp" />
							</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign>
							<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
								android:id="@+id/exploreDetailDesc"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:textAppearance="?attr/textAppearanceBodyMedium"
								android:textColor="?attr/colorOnSurface"
								android:maxLines="2"
								android:ellipsize="end" />
							<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
								android:id="@+id/exploreDetailReadMore"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:text="@string/read_more"
								android:textAppearance="?attr/textAppearanceLabelLarge"
								android:textColor="?attr/colorPrimary"
								android:visibility="gone" />
						</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
					</com.google.android.material.card.MaterialCardView>
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailChangelogSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:orientation="vertical"
					android:visibility="gone">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Changelog"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:textColor="?attr/colorOnSurface" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/exploreDetailChangelog"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:textColor="?attr/colorOnSurface" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailVersionsSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:orientation="vertical"
					android:visibility="gone">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Previous Versions"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:textColor="?attr/colorOnSurface" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
						android:id="@+id/exploreDetailVersions"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:orientation="vertical" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailSimilarSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:orientation="vertical"
					android:visibility="gone">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/related_apps_title"
						android:textAppearance="?attr/textAppearanceTitleLarge"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.RecyclerViewDesign
						android:id="@+id/exploreDetailSimilar"
						android:layout_width="match_parent"
						android:layout_height="190dp"
						android:layout_marginTop="8dp"
						android:nestedScrollingEnabled="false"
						android:overScrollMode="never" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/exploreDetailLinksSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:orientation="vertical">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/exploreDetailDonateSection"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:visibility="gone" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/exploreDetailDonateLink"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.NestedScrollViewDesign>
</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign>
