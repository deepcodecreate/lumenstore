<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/colorSurface"
		app:elevation="0dp"
		app:liftOnScroll="false">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.MaterialToolbarDesign
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:navigationIcon="@drawable/ic_arrow_back"
			app:navigationIconTint="?attr/colorOnSurface" />
	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign>
	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.NestedScrollViewDesign
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign
					android:layout_width="64dp"
					android:layout_height="64dp"
					android:background="@drawable/icon_container_bg">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
						android:id="@+id/detailAppIcon"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_gravity="center"
						android:contentDescription="@null" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign>
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_weight="1"
					android:orientation="vertical">
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/detailAppName"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textAppearance="?attr/textAppearanceHeadlineSmall"
						android:textColor="?attr/colorOnSurface" />
					<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
						android:id="@+id/detailVersions"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:textColor="?attr/colorOnSurfaceVariant" />
				</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/primaryActionRow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:orientation="horizontal">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/updateButton"
					android:layout_width="0dp"
					android:layout_height="wrap_content" android:minHeight="56dp"
					android:layout_weight="1"
					android:text="@string/btn_update"
					android:textAllCaps="false"
					app:cornerRadius="16dp" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/cancelDownloadButton"
style="@style/Widget.App.Button.TonalButton"
					android:layout_width="0dp"
					android:layout_height="wrap_content" android:minHeight="56dp"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					android:text="@string/cancel"
					android:textAllCaps="false"
					android:visibility="gone"
					app:cornerRadius="16dp" />
			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/installedActions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:orientation="horizontal"
				android:visibility="gone">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/openInstalledButton"
					android:layout_width="0dp"
					android:layout_height="wrap_content" android:minHeight="56dp"
					android:layout_weight="1"
					android:text="@string/action_run"
					android:textAllCaps="false"
					app:cornerRadius="16dp" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/uninstallInstalledButton"
style="@style/Widget.App.Button.TonalButton"
					android:layout_width="0dp"
					android:layout_height="wrap_content" android:minHeight="56dp"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					android:text="@string/uninstall"
					android:textAllCaps="false"
					app:cornerRadius="16dp" />
			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
			<com.google.android.material.progressindicator.LinearProgressIndicator
				style="@style/Widget.Material3.LinearProgressIndicator"
				android:id="@+id/buttonProgress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:visibility="gone"
				app:trackCornerRadius="8dp"
				app:trackThickness="6dp" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/latestButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content" android:minHeight="0dp"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/runButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content" android:minHeight="0dp"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/repoButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content" android:minHeight="0dp"
				android:visibility="gone" />
			<com.google.android.material.progressindicator.LinearProgressIndicator
				style="@style/Widget.Material3.LinearProgressIndicator"
				android:id="@+id/downloadProgress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:visibility="gone" />
			<com.google.android.material.progressindicator.LinearProgressIndicator
				style="@style/Widget.Material3.LinearProgressIndicator"
				android:id="@+id/readmeProgress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:indeterminate="true"
				app:trackCornerRadius="8dp"
				app:trackThickness="6dp" />
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
				app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/readmeView"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:textColor="?attr/colorOnSurface"
					android:textIsSelectable="true" />
			</com.google.android.material.card.MaterialCardView>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:text="Description"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:textColor="?attr/colorOnSurface" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/detailDescription"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorOnSurface"
				android:maxLines="2"
				android:ellipsize="end" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/detailReadMore"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/read_more"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:visibility="gone" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign
				android:id="@+id/detailInfoScroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:scrollbars="none"
				android:fillViewport="false">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
					android:id="@+id/detailInfoRow"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal" />
			</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign>
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/detailMetadataSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="22dp" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/detailChangelogSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="22dp"
				android:visibility="gone" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/detailPreviousVersionsSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="22dp"
				android:visibility="gone" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/detailScreenshotsSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="22dp"
				android:visibility="gone" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/detailSimilarSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="22dp"
				android:visibility="gone" />
		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.NestedScrollViewDesign>
</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign>
