<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/homeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:titleTextColor="?attr/colorOnSurface">
            <include
                layout="@layout/view_header_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />
        </com.google.android.material.appbar.MaterialToolbar>
        <LinearLayout
            android:id="@+id/homeHeaderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:clipToOutline="true"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
                app:strokeWidth="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.opensourcefinder.app.ui.ShapeView
                        android:id="@+id/heroShape"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-34dp"
                        android:layout_marginEnd="-26dp" />
                    <com.opensourcefinder.app.ui.ShapeView
                        android:id="@+id/heroShapeSmall"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="86dp"
                        android:layout_marginBottom="-12dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/appCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                tools:text="24 apps found" />
                            <TextView
                                android:id="@+id/heroTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                tools:text="3 updates available" />
                            <TextView
                                android:id="@+id/heroSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:alpha="0.8"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                tools:text="18 installed · 3 updates · 6 not installed" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/updateAllButton"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:minHeight="36dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="0dp"
                            android:text="@string/update_all"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:visibility="gone"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="16dp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/favoritesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/favoritesIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        app:tint="?attr/colorPrimary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/home_favorites"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favoritesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:layout_marginTop="6dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.opensourcefinder.app.ui.MaterialRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="2dp"
                android:paddingBottom="112dp" />
            <com.opensourcefinder.app.ui.ListSkeletonView
                android:id="@+id/homeLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="2dp" />
            <TextView
                android:id="@+id/emptyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textAlignment="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/no_results"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </FrameLayout>
    </com.opensourcefinder.app.ui.MaterialRefreshLayout>
    <LinearLayout
        android:id="@+id/headerActionsHolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/scanStatusButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/circle_avatar_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/scanStatusIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/scan_status_cd"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/circle_avatar_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/settingsButtonIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_title"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/moreButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/circle_avatar_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/moreButtonIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/home_more_cd"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/scanScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/scanPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="0dp"
        android:visibility="gone">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scanProgressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:shapeAppearance="?attr/shapeAppearanceCornerExtraLarge"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/scanTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_progress_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/scanPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    tools:text="42%" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                style="@style/Widget.App.LinearProgress"
                android:id="@+id/overallProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0" />
            <TextView
                android:id="@+id/scanCurrentItemText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Checking: com.example.app" />
            <include android:id="@+id/stageFdroid" layout="@layout/item_scan_stage" />
            <include android:id="@+id/stageGithub" layout="@layout/item_scan_stage" />
            <include android:id="@+id/stageManual" layout="@layout/item_scan_stage" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/scanPanelArrow"
        android:layout_gravity="top|left"
        android:elevation="0dp"
        android:layout_width="22dp"
        android:layout_height="11dp"
        android:layout_marginTop="0dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_bubble_arrow"
        app:tint="?attr/colorSurfaceContainerHigh" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/homeMenuPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="0dp"
        android:visibility="gone">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeMenuCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:shapeAppearance="?attr/shapeAppearanceCornerExtraLarge"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:id="@+id/homeMenuContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>
        <ImageView
            android:id="@+id/homeMenuArrow"
            android:layout_width="22dp"
            android:layout_height="11dp"
            android:layout_gravity="top|left"
            android:elevation="0dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_bubble_arrow"
            app:tint="?attr/colorSurfaceContainerHigh" />
    </FrameLayout>
    <View
        android:id="@+id/fabScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/fabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="30dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/fabMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabActionGithub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/fab_add_github"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:elevation="0dp"
                app:iconTint="?attr/colorOnSecondaryContainer" />
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabActionPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/fab_add_play"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:elevation="0dp"
                app:iconTint="?attr/colorOnSecondaryContainer" />
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addRepoFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/add_repository_cd"
            app:srcCompat="@drawable/ic_plus_rotating"
            app:tint="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
