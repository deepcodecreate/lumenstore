<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorPrimaryContainer" app:shapeAppearance="?attr/shapeAppearanceCornerLarge" app:cardElevation="0dp" app:strokeWidth="0dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/githubCardWatermark" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="-24dp" android:alpha="0.10" android:rotation="-14" android:contentDescription="@null" app:tint="?attr/colorOnPrimaryContainer" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="@dimen/github_card_icon" android:layout_height="@dimen/github_card_icon" app:cardBackgroundColor="?attr/colorPrimary" app:shapeAppearance="?attr/shapeAppearanceCornerMedium" app:cardElevation="0dp" app:strokeWidth="0dp">
                <ImageView android:id="@+id/githubCardIcon" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:contentDescription="@null" app:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="@string/github_explore_title" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:text="@string/github_explore_subtitle" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnPrimaryContainer" android:alpha="0.8" />
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron_right" android:contentDescription="@null" app:tint="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
